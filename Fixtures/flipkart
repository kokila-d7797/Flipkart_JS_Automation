require('dotenv').config();
const base = require('@playwright/test');
const HomePage = require('../pages/HomePage');
const SearchfunctionPage = require('../pages/Searchfunctionpage');
const LoginPage = require('../pages/LoginPage');
const product = require('../config/testData.json');
const mobile = (process.env.FLIPKART_MOBILE || '').replace(/\D/g, '').slice(-10);

// The only place the "search -> open first product" flow is written
async function openProductPage(page, searchTerm = product.productsearch.searchTerm) {
    const searchPage = new SearchfunctionPage(page);
    await searchPage.openResults(searchTerm);

    // Close the login popup if it shows up; never fail the test because of it
    await page.getByRole('button', { name: '✕', exact: true })
        .click({ timeout: 3000 })
        .catch(() => {});

    const productPage = await searchPage.openFirstProduct();
    await productPage.waitForLoaded();
    return productPage;
}

// A fresh context for beforeAll, where fixtures are not available

async function newSharedPage(browser, baseURL) {
    const url = baseURL || process.env.BASE_URL;

    if (!url) {
        throw new Error(
            'BASE_URL is missing. Add BASE_URL=https://www.flipkart.com to your .env file'
        );
    }

    const context = await browser.newContext({
        baseURL: url
    });

    return await context.newPage();
}

const test = base.test.extend({
    homePage: async ({ page }, use) => {
        const homePage = new HomePage(page);
        await homePage.navigateToHome();
        await use(homePage);
    },
    loginPage: async ({ page }, use) => {
        await use(new LoginPage(page));
    },
    productPage: async ({ page }, use) => {
        await use(await openProductPage(page));
    },
    // Login panel: use the tab where Buy now actually opened the login.
    // Falls back to the product tab if no new tab opens.
    productLoginPage: async ({ productPage }, use) => {
        await use(new LoginPage(productPage.page));
    },
});

module.exports = {
    test,
    expect: base.expect,
    openProductPage,
    newSharedPage,
    mobile,
};